diff --git a/scripts/test-bili-login-keeper.mjs b/scripts/test-bili-login-keeper.mjs
new file mode 100644
index 0000000..2c6fdcc
--- /dev/null
+++ b/scripts/test-bili-login-keeper.mjs
@@ -0,0 +1,218 @@
+// B站 登录守护：correspondPath 签名、refresh_csrf 解析、刷新链路、状态机。
+// 全部用 mock fetch / 临时 DSH_HOME，不联网、不动真实凭据。
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+
+const tmpHome = fs.mkdtempSync(path.join(os.tmpdir(), 'surfcore-login-keeper-'));
+process.env.DSH_HOME = tmpHome;
+const biliDir = path.join(tmpHome, 'surfcore', 'bili');
+fs.mkdirSync(biliDir, { recursive: true });
+const credFile = path.join(biliDir, 'credentials.json');
+
+const refresh = await import('../plugins/surfcore/lib/bili-cookie-refresh.mjs');
+const keeper = await import('../plugins/surfcore/lib/bili-login-keeper.mjs');
+const { normalizeBiliConfig } = await import('../plugins/surfcore/lib/store.js');
+
+// ── ① correspondPath：固定 256 位小写 hex（1024 位密钥 → 128 字节密文）─────
+const cp1 = refresh.getCorrespondPath(1793858224140);
+const cp2 = refresh.getCorrespondPath(1793858224140);
+assert.match(cp1, /^[0-9a-f]{256}$/, 'correspondPath 必须是 256 位小写 hex');
+assert.notEqual(cp1, cp2, 'RSA-OAEP 带随机填充，同输入两次结果也应不同（防写死）');
+assert.notEqual(refresh.getCorrespondPath(1793858224141), cp1);
+assert.throws(() => refresh.getCorrespondPath(0), /毫秒时间戳/);
+
+// ── ② HTML / Set-Cookie 解析 ──────────────────────────────────────────────
+const html = `<!DOCTYPE html><html><body>
+  <div id="1-name">b0cc8411ded2f9db2cff2edb3123acac</div>
+  <div id="token-iframe-app"></div></body></html>`;
+assert.equal(refresh.parseRefreshCsrf(html), 'b0cc8411ded2f9db2cff2edb3123acac');
+assert.equal(refresh.parseRefreshCsrf('<html><body>404 Page</body></html>'), '', '404 页面不能糊出一个 csrf');
+assert.equal(refresh.parseRefreshCsrf(`<div class="x" id='1-name'>  abcdefgh12345678  </div>`), 'abcdefgh12345678');
+
+const cookies = refresh.parseSetCookieList([
+  'SESSDATA=NEWSESS; Path=/; Domain=bilibili.com; Expires=Wed, 15 Nov 2023 07:34:10 GMT; HttpOnly; Secure',
+  'bili_jct=NEWJCT; Path=/; Domain=bilibili.com',
+  'DedeUserID=42; Path=/',
+  'bogus-line-without-equals',
+]);
+assert.equal(cookies.SESSDATA, 'NEWSESS');
+assert.equal(cookies.bili_jct, 'NEWJCT');
+assert.equal(cookies.DedeUserID, '42');
+assert.equal(refresh.cookieHeaderOf({ sessdata: 'S', bili_jct: 'J', buvid3: 'B' }), 'SESSDATA=S; bili_jct=J; buvid3=B');
+assert.equal(refresh.cookieHeaderOf({ sessdata: 'S', bili_jct: 'J' }), 'SESSDATA=S; bili_jct=J', 'buvid3 可空');
+assert.equal(refresh.normalizeCredential({ SESSDATA: ' s ', biliJct: 'j', acTimeValue: ' tok ' }).refreshToken, 'tok');
+
+// ── ③ 刷新链路（mock fetch）──────────────────────────────────────────────
+function jsonResponse(body, extra = {}) {
+  return { status: 200, text: async () => JSON.stringify(body), headers: { getSetCookie: () => extra.setCookies ?? [] } };
+}
+function htmlResponse(body, status = 200) {
+  return { status, text: async () => body, headers: { getSetCookie: () => [] } };
+}
+const REFRESH_TOKEN = 'rtoken-old-123';
+const infoNeedsRefresh = { code: 0, message: '0', data: { refresh: true, timestamp: 1793858224140 } };
+const infoNoRefresh = { code: 0, message: '0', data: { refresh: false, timestamp: 1793858224140 } };
+const correspondHtml = '<html><div id="1-name">' + 'a'.repeat(32) + '</div></html>';
+const refreshOk = {
+  code: 0, message: '0',
+  data: { status: 0, message: '', refresh_token: 'rtoken-new-456' },
+};
+
+function makeFetch(routes) {
+  const entries = Object.entries(routes);
+  return async (url, init = {}) => {
+    const method = String(init.method || 'GET').toUpperCase();
+    for (const [pattern, hit] of entries) {
+      const space = pattern.indexOf(' ');
+      const patternMethod = pattern.slice(0, space).toUpperCase();
+      const target = pattern.slice(space + 1);
+      const matched = patternMethod === method
+        && (target.endsWith('*') ? String(url).startsWith(target.slice(0, -1)) : String(url) === target);
+      if (!matched) continue;
+      return typeof hit === 'function' ? hit(init) : hit;
+    }
+    throw new Error(`未 mock 的请求：${method} ${url}`);
+  };
+}
+
+const baseCred = { sessdata: 'SESS', bili_jct: 'JCT', buvid3: 'BUVID3', refreshToken: REFRESH_TOKEN };
+
+// 没有 refresh_token → 明确拒绝，不去猜
+let result = await refresh.refreshCookie({ sessdata: 'S', bili_jct: 'J' }, { fetchImpl: async () => { throw new Error('不该发请求'); } });
+assert.equal(result.ok, false);
+assert.equal(result.code, 'bili.no-refresh-token');
+
+// cookie 失效（-101）
+result = await refresh.refreshCookie(baseCred, {
+  fetchImpl: makeFetch({
+    'GET https://passport.bilibili.com/x/passport-login/web/cookie/info?csrf=JCT': jsonResponse({ code: -101, message: '账号未登录' }),
+  }),
+});
+assert.equal(result.ok, false);
+assert.equal(result.code, 'bili.cookie-expired');
+
+// 不需要刷新 → 什么都不换
+result = await refresh.refreshCookie(baseCred, {
+  fetchImpl: makeFetch({
+    'GET https://passport.bilibili.com/x/passport-login/web/cookie/info?csrf=JCT': jsonResponse(infoNoRefresh),
+  }),
+});
+assert.equal(result.ok, true);
+assert.equal(result.refreshed, false);
+
+// 完整成功：info → correspond → refresh（拿新 cookie 和新令牌）
+const successFetch = makeFetch({
+  'GET https://passport.bilibili.com/x/passport-login/web/cookie/info?csrf=JCT': jsonResponse(infoNeedsRefresh),
+  'GET https://www.bilibili.com/correspond/1/*': htmlResponse(correspondHtml),
+  'POST https://passport.bilibili.com/x/passport-login/web/cookie/refresh': (init) => {
+    assert.match(String(init.body), /source=main_web/, '必须带 source=main_web');
+    assert.match(String(init.body), /refresh_token=rtoken-old-123/, '必须带旧 refresh_token');
+    return jsonResponse(refreshOk, {
+      setCookies: ['SESSDATA=NEWSESS; Path=/', 'bili_jct=NEWJCT; Path=/', 'DedeUserID=42; Path=/'],
+    });
+  },
+  'POST https://passport.bilibili.com/x/passport-login/web/confirm/refresh': jsonResponse({ code: 0, message: '0', ttl: 1 }),
+});
+result = await refresh.refreshCookie(baseCred, { fetchImpl: successFetch });
+assert.equal(result.ok, true, JSON.stringify(result));
+assert.equal(result.refreshed, true);
+assert.equal(result.cred.sessdata, 'NEWSESS');
+assert.equal(result.cred.bili_jct, 'NEWJCT');
+assert.equal(result.cred.refreshToken, 'rtoken-new-456');
+assert.equal(result.cred.buvid3, 'BUVID3', '新响应没给 buvid3 时保留旧值');
+assert.equal(result.oldRefreshToken, REFRESH_TOKEN);
+const confirm = await refresh.confirmRefresh(result.cred, result.oldRefreshToken, { fetchImpl: successFetch });
+assert.equal(confirm.ok, true);
+
+// 86095：令牌与 cookie 不匹配
+result = await refresh.refreshCookie(baseCred, {
+  fetchImpl: makeFetch({
+    'GET https://passport.bilibili.com/x/passport-login/web/cookie/info?csrf=JCT': jsonResponse(infoNeedsRefresh),
+    'GET https://www.bilibili.com/correspond/1/*': htmlResponse(correspondHtml),
+    'POST https://passport.bilibili.com/x/passport-login/web/cookie/refresh': jsonResponse({ code: 86095, message: '请求错误' }),
+  }),
+});
+assert.equal(result.ok, false);
+assert.equal(result.code, 'bili.refresh-failed');
+assert.match(result.error, /86095/);
+
+// correspond 页 404（correspondPath 过期）→ 明确失败，不发刷新
+result = await refresh.refreshCookie(baseCred, {
+  fetchImpl: makeFetch({
+    'GET https://passport.bilibili.com/x/passport-login/web/cookie/info?csrf=JCT': jsonResponse(infoNeedsRefresh),
+    'GET https://www.bilibili.com/correspond/1/*': htmlResponse('404 Page', 404),
+  }),
+});
+assert.equal(result.ok, false);
+assert.equal(result.code, 'bili.correspond-failed');
+
+// ── ④ 守护状态机（临时目录里的真实凭据文件）───────────────────────────────
+function writeCred(extra) {
+  fs.writeFileSync(credFile, JSON.stringify({
+    sessdata: 'SESS', bili_jct: 'JCT', buvid3: 'BUVID3',
+    mid: '42', name: '测试鱼', savedAt: '2026-11-05T00:00:00.000Z', ...extra,
+  }), 'utf8');
+}
+const fetchNoRefresh = makeFetch({
+  'GET https://passport.bilibili.com/x/passport-login/web/cookie/info?csrf=JCT': jsonResponse(infoNoRefresh),
+});
+
+assert.equal((await keeper.runLoginKeeper({ target: 'fish', notify: false, fetchImpl: fetchNoRefresh })).status, 'missing', '没凭据 → missing');
+
+writeCred({});
+let r = await keeper.runLoginKeeper({ target: 'fish', notify: false, fetchImpl: fetchNoRefresh });
+assert.equal(r.status, 'ok');
+const statusAfter = keeper.loginKeeperStatus();
+assert.equal(statusAfter.targets.fish.hasRefreshToken, false);
+assert.equal(statusAfter.targets.fish.lastStatus, 'ok');
+assert.ok(statusAfter.targets.fish.lastCheckAt, '要记录检查时间');
+assert.ok(statusAfter.targets.fish.nextCheckAt, '要给出下次检查时间');
+assert.equal(keeper.loginKeeperDue({ target: 'fish' }), false, '刚查过不应立刻再查');
+assert.ok(!JSON.stringify(statusAfter).includes('SESS'), '状态接口不能泄露 cookie 值');
+
+// 需要续期但没令牌 → 明确状态（不自动乱来）
+r = await keeper.runLoginKeeper({ target: 'fish', notify: false, fetchImpl: makeFetch({
+  'GET https://passport.bilibili.com/x/passport-login/web/cookie/info?csrf=JCT': jsonResponse(infoNeedsRefresh),
+}) });
+assert.equal(r.status, 'no-refresh-token');
+
+// 有令牌 + B站 说该续 → 自动续期、落盘新凭据、确认旧令牌
+writeCred({ refreshToken: REFRESH_TOKEN });
+r = await keeper.runLoginKeeper({ target: 'fish', notify: false, fetchImpl: successFetch });
+assert.equal(r.status, 'refreshed', JSON.stringify(r));
+const saved = JSON.parse(fs.readFileSync(credFile, 'utf8'));
+assert.equal(saved.sessdata, 'NEWSESS');
+assert.equal(saved.bili_jct, 'NEWJCT');
+assert.equal(saved.refreshToken, 'rtoken-new-456');
+assert.equal(saved.mid, '42', '续期不能把 mid 弄丢');
+assert.equal(saved.name, '测试鱼', '续期不能把昵称弄丢');
+assert.ok(saved.refreshedAt, '要记录最近续期时间');
+assert.ok(fs.statSync(credFile).isFile());
+const statusRefreshed = keeper.loginKeeperStatus();
+assert.equal(statusRefreshed.targets.fish.hasRefreshToken, true);
+assert.ok(statusRefreshed.targets.fish.lastRefreshAt);
+assert.ok(!JSON.stringify(statusRefreshed).includes('rtoken-new-456'), '状态接口不能泄露令牌值');
+
+// 过期：接口 -101 → expired（不再尝试刷新）
+r = await keeper.runLoginKeeper({ target: 'fish', notify: false, fetchImpl: makeFetch({
+  'GET https://passport.bilibili.com/x/passport-login/web/cookie/info?csrf=NEWJCT': jsonResponse({ code: -101, message: '账号未登录' }),
+}) });
+assert.equal(r.status, 'expired');
+
+// 网络错：别误报成过期
+r = await keeper.runLoginKeeper({ target: 'fish', notify: false, fetchImpl: async () => { throw new Error('ECONNRESET'); } });
+assert.equal(r.status, 'error');
+
+// ── ⑤ 配置归一 ───────────────────────────────────────────────────────────
+const normalized = normalizeBiliConfig({ loginKeeper: { intervalHours: 0, enabled: false, autoRefresh: false } });
+assert.equal(normalized.loginKeeper.enabled, false);
+assert.equal(normalized.loginKeeper.autoRefresh, false);
+assert.equal(normalized.loginKeeper.intervalHours, 1, '间隔下限 1 小时');
+assert.equal(normalizeBiliConfig({}).loginKeeper.enabled, true, '默认开启');
+assert.equal(normalizeBiliConfig({ loginKeeper: { intervalHours: 999 } }).loginKeeper.intervalHours, 168);
+
+// 收尾：临时目录清掉
+try { fs.rmSync(tmpHome, { recursive: true, force: true }); } catch {}
+console.log('OK test-bili-login-keeper');
diff --git a/scripts/test-bili-share-prompt.mjs b/scripts/test-bili-share-prompt.mjs
new file mode 100644
index 0000000..2d750ad
--- /dev/null
+++ b/scripts/test-bili-share-prompt.mjs
@@ -0,0 +1,40 @@
+// B站定时分享提示词：二代仿真必须带会话 key/token（2026-11-05 修），否则工具全 403。
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { buildSharePrompt } from '../src/bili-share-scheduler.js';
+
+const root = fileURLToPath(new URL('..', import.meta.url));
+const card = { title: '测试视频', url: 'https://www.bilibili.com/video/BV1xx411c7mD', reason: '看了个视频' };
+
+// ① reserved2：带 key/token
+const reserved = buildSharePrompt(card, '16:30', {
+  mode: 'reserved2', sessionKey: 'group:200000001', token: 'tok-abc123',
+});
+assert.match(reserved, /key=group:200000001/, '带会话 key');
+assert.match(reserved, /tok-abc123/, '带会话令牌');
+assert.match(reserved, /mcp__snowluma__qq_send_message/, '告诉模型用发送工具');
+assert.match(reserved, /不要写进消息、不要外传/, 'token 不能外泄');
+
+// ② reserved2 + 主人私聊
+const privatePrompt = buildSharePrompt(card, '16:30', {
+  mode: 'reserved2', privateTarget: true, sessionKey: 'private:10000001', token: 'tok-xyz',
+});
+assert.match(privatePrompt, /私聊/);
+assert.match(privatePrompt, /key=private:10000001/);
+assert.match(privatePrompt, /tok-xyz/);
+
+// ③ chat 模式不加 token 行（自动发送，不需要工具）
+const chat = buildSharePrompt(card, '16:30', { mode: 'chat' });
+assert.ok(!chat.includes('会话令牌'), 'chat 模式不需要令牌');
+assert.match(chat, /只输出要发到群里的内容/);
+
+// ④ 接线：桥接传 getSessionToken；scheduler 接受完整 key
+const schedulerSrc = fs.readFileSync(path.join(root, 'src/bili-share-scheduler.js'), 'utf8');
+assert.match(schedulerSrc, /getSessionToken = \(\) => ''/, 'scheduler 有 getSessionToken 选项');
+assert.match(schedulerSrc, /includes\(':'\) \? String\(target\) : `group:\$\{target\}`/, '完整 key 不再重复加 group:');
+const bridgeSrc = fs.readFileSync(path.join(root, 'src/bridge.js'), 'utf8');
+assert.match(bridgeSrc, /getSessionToken: \(key\) => String\(getSocialV2State\(key\)\?\.agentToken/, '桥接提供会话令牌');
+
+console.log('OK test-bili-share-prompt');
diff --git a/scripts/test-cross-task.mjs b/scripts/test-cross-task.mjs
new file mode 100644
index 0000000..07a8662
--- /dev/null
+++ b/scripts/test-cross-task.mjs
@@ -0,0 +1,140 @@
+// 跨会话事务台（方案 B）：配置归一、发起人档位限次、范围校验、peek 裁剪、提示词/审计格式 + 接线契约。
+// 纯函数 + 静态检查，不联网、不启动桥接。
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const root = fileURLToPath(new URL('..', import.meta.url));
+const {
+  DEFAULT_CROSS_TASK, buildPeekSlice, crossSendPolicyError, crossTaskAuditLine,
+  crossTaskDailyLimit, formatCrossTaskPrompt, normalizeCrossTaskConfig, validateCrossTaskRequest,
+} = await import('../src/cross-task.js');
+
+const ownerQQ = '10000001';
+const gate = normalizeCrossTaskConfig({});
+const allowedKeys = new Set(['group:200000001', 'group:200000002', 'private:10000001', 'private:10000002']);
+const baseAllowed = (k, kind, id) => allowedKeys.has(`${kind}:${id}`);
+const owner = { personId: ownerQQ, isOwner: true, isWhitelisted: true, affection: 100, name: '主人' };
+const whitelisted = { personId: '111', isOwner: false, isWhitelisted: true, affection: 20, name: '白名单' };
+const high = { personId: '222', isOwner: false, isWhitelisted: false, affection: 60, name: '高好感' };
+const low = { personId: '333', isOwner: false, isWhitelisted: false, affection: 30, name: '普通' };
+
+// ── ① 配置默认值 ───────────────────────────────────────────────────────────
+assert.equal(DEFAULT_CROSS_TASK.ownerOnly, false, '默认非主人也能发起');
+assert.equal(DEFAULT_CROSS_TASK.allowPrivateToGroup, true, '私聊→群默认由小光自审');
+assert.equal(DEFAULT_CROSS_TASK.allowGroupToPrivate, true);
+assert.equal(DEFAULT_CROSS_TASK.highAffectionDaily, 5);
+assert.equal(DEFAULT_CROSS_TASK.defaultDaily, 3);
+const d = normalizeCrossTaskConfig(undefined);
+assert.equal(d.ownerOnly, false);
+assert.equal(d.highAffectionAt, 60);
+assert.equal(normalizeCrossTaskConfig({ ownerOnly: true }).ownerOnly, true);
+assert.equal(normalizeCrossTaskConfig({ ttlMs: 1 }).ttlMs, 60_000);
+assert.equal(normalizeCrossTaskConfig({ maxTasksPerDay: 9e9 }).maxTasksPerDay, 2000);
+
+// ── ② 发起人档位 ───────────────────────────────────────────────────────────
+assert.equal(crossTaskDailyLimit({ requester: owner, gate }), 0, '主人不限次');
+assert.equal(crossTaskDailyLimit({ requester: whitelisted, gate }), 0, '白名单不限次');
+assert.equal(crossTaskDailyLimit({ requester: high, gate }), 5, '好感 ≥60 每天 5 次');
+assert.equal(crossTaskDailyLimit({ requester: { ...high, affection: 59 }, gate }), 3, '好感 <60 每天 3 次');
+assert.equal(crossTaskDailyLimit({ requester: low, gate }), 3);
+assert.equal(crossTaskDailyLimit({ requester: whitelisted, gate: { ...gate, trustedWhitelistUnlimited: false } }), 3, '关掉白名单不限次后按好感档');
+assert.equal(crossTaskDailyLimit({ requester: high, gate: { ...gate, highAffectionAt: 70 } }), 3);
+
+// ── ③ 请求校验 ─────────────────────────────────────────────────────────────
+const okReq = validateCrossTaskRequest({
+  requesterKey: 'private:10000001', task: '把群里刚才聊的整理给我', readKeys: ['group:200000001'],
+  sendTargets: ['private:10000001'], requester: owner, allowed: baseAllowed,
+  dailyCount: 999, totalDailyCount: 0, activeForSource: 0, ownerQQ, gate,
+});
+assert.equal(okReq.ok, true, JSON.stringify(okReq));
+
+// 群会话也能发起（非主人）
+const groupReq = validateCrossTaskRequest({
+  requesterKey: 'group:200000001', task: '整理一下', readKeys: ['group:200000001'],
+  sendTargets: ['private:10000001'], requester: high, allowed: baseAllowed,
+  dailyCount: 0, totalDailyCount: 0, activeForSource: 0, ownerQQ, gate,
+});
+assert.equal(groupReq.ok, true, JSON.stringify(groupReq));
+assert.equal(groupReq.dailyLimit, 5);
+
+// ownerOnly=true 时才限主人
+assert.match(validateCrossTaskRequest({
+  requesterKey: 'group:200000001', task: 'x', readKeys: ['group:200000001'], sendTargets: ['private:10000001'],
+  requester: high, allowed: baseAllowed, dailyCount: 0, totalDailyCount: 0, activeForSource: 0, ownerQQ,
+  gate: { ...gate, ownerOnly: true },
+}).error, /只允许主人/);
+
+// 次数：好感 ≥60 第 5 次后拒绝；<60 第 3 次后拒绝
+assert.match(validateCrossTaskRequest({ requesterKey: 'group:200000001', task: 'x', readKeys: ['group:200000001'], sendTargets: ['private:10000001'], requester: high, allowed: baseAllowed, dailyCount: 5, totalDailyCount: 0, activeForSource: 0, ownerQQ, gate }).error, /每天最多 5/);
+assert.match(validateCrossTaskRequest({ requesterKey: 'group:200000001', task: 'x', readKeys: ['group:200000001'], sendTargets: ['private:10000001'], requester: low, allowed: baseAllowed, dailyCount: 3, totalDailyCount: 0, activeForSource: 0, ownerQQ, gate }).error, /每天最多 3/);
+// 主人/白名单不受个人次数限制（但受全局上限）
+assert.equal(validateCrossTaskRequest({ requesterKey: 'private:10000001', task: 'x', readKeys: ['group:200000001'], sendTargets: ['private:10000001'], requester: owner, allowed: baseAllowed, dailyCount: 999, totalDailyCount: 0, activeForSource: 0, ownerQQ, gate }).ok, true);
+assert.match(validateCrossTaskRequest({ requesterKey: 'private:10000001', task: 'x', readKeys: ['group:200000001'], sendTargets: ['private:10000001'], requester: owner, allowed: baseAllowed, dailyCount: 0, totalDailyCount: 200, activeForSource: 0, ownerQQ, gate }).error, /全局/);
+
+// 空任务/空读/空发/越界
+assert.match(validateCrossTaskRequest({ requesterKey: 'private:10000001', task: '  ', readKeys: ['group:200000001'], sendTargets: ['private:10000001'], requester: owner, allowed: baseAllowed, ownerQQ, gate }).error, /任务描述/);
+assert.match(validateCrossTaskRequest({ requesterKey: 'private:10000001', task: 'x', readKeys: [], sendTargets: ['private:10000001'], requester: owner, allowed: baseAllowed, ownerQQ, gate }).error, /要读/);
+assert.match(validateCrossTaskRequest({ requesterKey: 'private:10000001', task: 'x', readKeys: ['group:200000001'], sendTargets: [], requester: owner, allowed: baseAllowed, ownerQQ, gate }).error, /发送目标/);
+assert.match(validateCrossTaskRequest({ requesterKey: 'private:10000001', task: 'x', readKeys: ['group:999999'], sendTargets: ['private:10000001'], requester: owner, allowed: baseAllowed, ownerQQ, gate }).error, /不能读取/);
+assert.match(validateCrossTaskRequest({ requesterKey: 'private:10000001', task: 'x', readKeys: ['group:200000001'], sendTargets: ['group:999999'], requester: owner, allowed: baseAllowed, ownerQQ, gate }).error, /不能发送/);
+assert.match(validateCrossTaskRequest({ requesterKey: 'private:10000001', task: 'x', readKeys: ['group:200000001'], sendTargets: ['private:10000001'], requester: owner, allowed: baseAllowed, activeForSource: 1, ownerQQ, gate }).error, /已经有一个/);
+
+// ── ④ 内容边界：默认放开，交给小光自审；显式关掉才硬拦 ─────────────────────
+assert.equal(crossSendPolicyError({ readKeys: ['private:10000001'], targetKey: 'group:200000001', gate }), '');
+assert.equal(crossSendPolicyError({ readKeys: ['group:200000001'], targetKey: 'private:10000002', gate }), '');
+assert.match(crossSendPolicyError({ readKeys: ['private:10000001'], targetKey: 'group:200000001', gate: { ...gate, allowPrivateToGroup: false } }), /私聊→群/);
+assert.match(crossSendPolicyError({ readKeys: ['group:200000001'], targetKey: 'private:10000002', gate: { ...gate, allowGroupToPrivate: false } }), /群→私聊/);
+
+// ── ⑤ peek 裁剪 ────────────────────────────────────────────────────────────
+const long = Array.from({ length: 10 }, (_, i) => ({ text: `第${i}条`, isSelf: false, sender: '甲', messageId: String(i), time: 1000 + i }));
+const slice = buildPeekSlice(long, { limit: 3, maxChars: 4000 });
+assert.equal(slice.length, 3);
+assert.equal(slice[2].text, '第9条');
+assert.equal(slice[0].text, '第7条');
+assert.equal(buildPeekSlice([{ text: '' }, { text: ' ' }], {}).length, 0);
+assert.ok(buildPeekSlice(Array.from({ length: 5 }, () => ({ text: 'x'.repeat(100) })), { limit: 5, maxChars: 250 }).length <= 2);
+
+// ── ⑥ 提示词 / 审计格式 ────────────────────────────────────────────────────
+const prompt = formatCrossTaskPrompt({
+  persona: '你是小光。', task: '把群里聊的整理给我', reads: ['group:200000001'], sends: ['private:10000001'],
+  token: 'tok-123', taskKey: 'cross:abcd', limits: gate, names: { 'group:200000001': '测试群' },
+  requester: high,
+});
+assert.match(prompt, /【跨会话事务台】/);
+assert.match(prompt, /测试群/);
+assert.match(prompt, /tok-123/);
+assert.match(prompt, /怎么判断该不该帮/);
+assert.match(prompt, /好感度 60/);
+assert.match(prompt, /小光自己的口吻复述/, '允许用小光口吻复述');
+assert.match(prompt, /谁说的、数字、时间、条件、约定/, '复述时关键信息不能改');
+assert.match(prompt, /qq_peek_conversation/);
+assert.match(prompt, /qq_cross_send/);
+assert.match(prompt, /qq_cross_finish/);
+const audit = JSON.parse(crossTaskAuditLine({ taskId: 't1', sourceKey: 'private:1', requester: high, task: 'x', reads: ['group:2'], sends: ['private:1'], sent: [{ targetKey: 'private:1', text: 'hi' }], summary: 'done' }));
+assert.equal(audit.taskId, 't1');
+assert.equal(audit.requester.isOwner, false);
+
+// ── ⑦ 接线契约（静态）────────────────────────────────────────────────────
+const bridgeSrc = fs.readFileSync(path.join(root, 'src/bridge.js'), 'utf8');
+assert.match(bridgeSrc, /'\/api\/socialV2\/cross-task'/);
+assert.match(bridgeSrc, /'\/api\/socialV2\/cross-peek'/);
+assert.match(bridgeSrc, /'\/api\/socialV2\/cross-send'/);
+assert.match(bridgeSrc, /'\/api\/socialV2\/cross-finish'/);
+assert.match(bridgeSrc, /async function createCrossSession/);
+assert.match(bridgeSrc, /KNOWN_AGENT_TOKENS\.add\(crossToken\)/);
+assert.match(bridgeSrc, /socialV2\.crossTask = normalizeCrossTaskConfig/);
+assert.match(bridgeSrc, /crossPersonDaily\(personId\)/, '按人记的每日次数');
+assert.match(bridgeSrc, /bumpCrossPersonDaily\(personId\)/, '成功后按人记账');
+assert.match(bridgeSrc, /【跨会话】/, '唤醒提示会告诉它可以发起事务台');
+assert.match(bridgeSrc, /voiceLastSpeaker\.get\(key\)\?\.userId/, '群聊取最后说话的人当请求人');
+
+const mcpSrc = fs.readFileSync(path.join(root, 'src/mcp-snowluma-safe.js'), 'utf8');
+for (const name of ['qq_cross_task', 'qq_peek_conversation', 'qq_cross_send', 'qq_cross_finish']) {
+  assert.match(mcpSrc, new RegExp(`'${name}'`), `MCP 注册 ${name}`);
+  assert.match(mcpSrc, new RegExp(`${name}: 'crossTask'`), `${name} 受 crossTask 开关控制`);
+}
+assert.match(mcpSrc, /好感度 ≥60 的人每天最多 5 次/, '工具描述写清发起人档位');
+
+console.log('OK test-cross-task');
diff --git a/scripts/test-startup-prepare.mjs b/scripts/test-startup-prepare.mjs
new file mode 100644
index 0000000..fedc41a
--- /dev/null
+++ b/scripts/test-startup-prepare.mjs
@@ -0,0 +1,65 @@
+// 「DSH 启动准备」：配置归一（组件/延迟/语音包）+ 接线契约（插件启动时自动跑、概览可开关）。
+// 纯函数与静态契约，不启动 DSH / 不联网。
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const root = fileURLToPath(new URL('..', import.meta.url));
+const { DEFAULT_STARTUP, normalizeStartupConfig } = await import('../plugins/surfcore/lib/store.js');
+
+// ── ① 默认值 ───────────────────────────────────────────────────────────────
+assert.equal(DEFAULT_STARTUP.enabled, true, '默认开启');
+assert.deepEqual(DEFAULT_STARTUP.components, ['qq', 'bili', 'voice'], '默认顺序 QQ → B站 → 语音');
+assert.equal(DEFAULT_STARTUP.voicePack, 'voice-local');
+
+// ── ② 配置归一 ─────────────────────────────────────────────────────────────
+const d = normalizeStartupConfig(undefined);
+assert.equal(d.enabled, true);
+assert.deepEqual(d.components, ['qq', 'bili', 'voice']);
+assert.equal(d.voicePack, 'voice-local');
+assert.equal(d.delayMs, 8000);
+
+assert.equal(normalizeStartupConfig({ enabled: false }).enabled, false);
+assert.deepEqual(normalizeStartupConfig({ components: ['voice', 'qq', 'voice', 'bogus'] }).components, ['voice', 'qq'], '去重 + 丢弃未知组件');
+assert.deepEqual(normalizeStartupConfig({ components: [] }).components, ['qq', 'bili', 'voice'], '空数组回默认，不会变成「什么都不启动」');
+assert.equal(normalizeStartupConfig({ voicePack: 'voice-cloud' }).voicePack, 'voice-cloud');
+assert.equal(normalizeStartupConfig({ voicePack: 'weird' }).voicePack, 'voice-local', '未知语音包回本地');
+assert.equal(normalizeStartupConfig({ delayMs: 0 }).delayMs, 3000, '延迟下限 3 秒');
+assert.equal(normalizeStartupConfig({ delayMs: 999999 }).delayMs, 120000, '延迟上限 120 秒');
+assert.equal(normalizeStartupConfig({ delayMs: 12345.7 }).delayMs, 12346, '四舍五入取整');
+
+// ── ③ 插件接线：启动时自动跑 + 顺序 + 幂等 + 概览接口 ─────────────────────
+const indexSrc = fs.readFileSync(path.join(root, 'plugins/surfcore/lib/index.js'), 'utf8');
+assert.match(indexSrc, /scheduleStartupPrepare\(\);/, '插件激活时会安排启动准备');
+assert.match(indexSrc, /function scheduleStartupPrepare\(/, '有 scheduleStartupPrepare');
+assert.match(indexSrc, /function runStartupPrepare\(/, '有 runStartupPrepare');
+assert.match(indexSrc, /const STARTUP_COMPONENTS = \['qq', 'bili', 'voice'\]/, '组件顺序 QQ → B站 → 语音');
+assert.match(indexSrc, /function waitForBridgeUp\(/, '语音启动前等桥接就绪（语音包由桥接托管）');
+assert.match(indexSrc, /\$\{API_PREFIX\}\/startup/, '有 /startup 接口');
+assert.match(indexSrc, /if \(cfg\.enabled === false/, '关掉开关就不自动跑');
+assert.match(indexSrc, /startupComponentReady\(id, status\)/, '已在跑就跳过（幂等）');
+assert.match(indexSrc, /if \(startupPrepareTimer\) \{ clearTimeout\(startupPrepareTimer\)/, '销毁时清掉定时器');
+assert.match(indexSrc, /startComponent\(id, \{ voicePack \}\)/, '复用一键启动的 startComponent');
+
+// ── ④ 设置页：开关 + 立即准备 + 上次结果 ──────────────────────────────────
+const clientSrc = fs.readFileSync(path.join(root, 'plugins/surfcore/lib/client.js'), 'utf8');
+assert.match(clientSrc, /\["startup", "enabled"\]/, '概览有启动准备开关（写 unified.startup.enabled）');
+assert.match(clientSrc, /api\("\/startup"/, '概览能读/触发启动准备');
+assert.match(clientSrc, /DSH 启动准备（自动）/, '概览有对应分组标题');
+assert.match(clientSrc, /立即准备一次/, '有手动立即准备按钮');
+
+// ── ④b 语音包启动：detached 启动器 exit 0 不能被当成失败 ────────────────────
+// 本地包 run.bat 用 `start "" /b pythonw ...` 拉起服务后自己立刻退出；
+// 旧逻辑「进程退出就 break」会误报 VOICE_START_EXITED（2026-11-05 实测）。
+const voicePacksSrc = fs.readFileSync(path.join(root, 'src/voice-packs.js'), 'utf8');
+assert.match(voicePacksSrc, /exitCode !== null && exitCode !== 0/, 'exit 0 继续等端口，只有非 0 才提前失败');
+assert.match(voicePacksSrc, /exitCode === null \|\| exitCode === 0/, 'detached 启动器退出但端口没起来时按超时报');
+
+// ── ⑤ 统一配置默认值里有 startup（readUnified 会合并）─────────────────────
+const storeSrc = fs.readFileSync(path.join(root, 'plugins/surfcore/lib/store.js'), 'utf8');
+assert.match(storeSrc, /startup: DEFAULT_STARTUP/, 'DEFAULT_UNIFIED 带 startup 默认值');
+assert.match(storeSrc, /config\.startup = normalizeStartupConfig\(config\.startup\)/, 'readUnified 归一 startup');
+assert.match(storeSrc, /next\.startup = normalizeStartupConfig\(next\.startup\)/, 'saveUnified 归一 startup');
+
+console.log('OK test-startup-prepare');
diff --git a/scripts/test-voice-affection.mjs b/scripts/test-voice-affection.mjs
new file mode 100644
index 0000000..e281d59
--- /dev/null
+++ b/scripts/test-voice-affection.mjs
@@ -0,0 +1,132 @@
+// 语音好感度门槛：分数读取 / 解锁判定 / 低频冷却与每日上限 / 记账跨天。
+// 纯逻辑 + 临时文件，不联网、不启动桥接。
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+
+const {
+  DEFAULT_VOICE_AFFECTION, affectionLookup, loadAffection, loadVoiceAffectionState,
+  localDayKey, normalizeVoiceAffection, noteVoiceAffectionSent, saveVoiceAffectionState,
+  voiceAffectionDecision, voiceAffectionStateFile, voiceAffectionUsage,
+} = await import('../src/voice-affection.js');
+
+const tmp = fs.mkdtempSync(path.join(os.tmpdir(), 'surfcore-voice-affection-'));
+const affectionFile = path.join(tmp, 'affection.json');
+const stateFile = path.join(tmp, 'state', 'voice-affection.json');
+const day = localDayKey();
+
+// ── ① 配置归一 ─────────────────────────────────────────────────────────────
+assert.deepEqual(normalizeVoiceAffection(undefined), {
+  enabled: true,
+  fullAt: DEFAULT_VOICE_AFFECTION.fullAt,
+  lowCooldownHours: DEFAULT_VOICE_AFFECTION.lowCooldownHours,
+  lowMaxPerDay: DEFAULT_VOICE_AFFECTION.lowMaxPerDay,
+  lowWindowMinutes: DEFAULT_VOICE_AFFECTION.lowWindowMinutes,
+  unknownScore: DEFAULT_VOICE_AFFECTION.unknownScore,
+});
+assert.equal(normalizeVoiceAffection({ enabled: false }).enabled, false);
+assert.equal(normalizeVoiceAffection({ fullAt: 999 }).fullAt, 100, '门槛上限 100');
+assert.equal(normalizeVoiceAffection({ fullAt: -5 }).fullAt, 0);
+assert.equal(normalizeVoiceAffection({ lowCooldownHours: 999 }).lowCooldownHours, 168);
+assert.equal(normalizeVoiceAffection({ lowMaxPerDay: -1 }).lowMaxPerDay, 0);
+assert.equal(normalizeVoiceAffection({ lowWindowMinutes: 0 }).lowWindowMinutes, 1);
+
+// ── ② 好感度读取 ───────────────────────────────────────────────────────────
+assert.deepEqual(loadAffection(affectionFile), { people: {}, ownerFloor: 75, updatedAt: '' }, '文件不存在时为空表');
+fs.writeFileSync(affectionFile, JSON.stringify({
+  updatedAt: '2026-11-05 14:10:07',
+  ownerFloor: 75,
+  people: {
+    '10000001': { name: '主人', score: 100, band: '最喜欢' },
+    '2781448117': { name: '呃呃呃', score: 59, band: '朋友' },
+    '10000002': { name: '喻书', score: 54, band: '朋友' },
+    broken: { name: '坏键', score: 80 },
+  },
+}), 'utf8');
+const affection = loadAffection(affectionFile);
+assert.equal(affection.people['2781448117'].score, 59);
+assert.equal(affection.people.broken, undefined, '非 QQ 号的键不能进名单');
+assert.equal(affection.ownerFloor, 75);
+
+const owner = affectionLookup(affection, '10000001', { ownerQQ: '10000001' });
+assert.equal(owner.isOwner, true);
+assert.equal(owner.score, 100);
+assert.equal(owner.name, '主人');
+
+const lowGuy = affectionLookup(affection, '2781448117', { ownerQQ: '10000001' });
+assert.equal(lowGuy.score, 59);
+assert.equal(lowGuy.known, true);
+
+const stranger = affectionLookup(affection, '999999', { ownerQQ: '10000001', unknownScore: 40 });
+assert.equal(stranger.score, 40, '名单外的人按 unknownScore');
+assert.equal(stranger.known, false);
+
+// 主人即使文件里分数低，也按 ownerFloor 兜底（affection.ps1 的硬地板）
+const lowOwnerFile = path.join(tmp, 'affection-lowowner.json');
+fs.writeFileSync(lowOwnerFile, JSON.stringify({ ownerFloor: 75, people: { '111': { score: 10 } } }), 'utf8');
+assert.equal(affectionLookup(loadAffection(lowOwnerFile), '111', { ownerQQ: '111' }).score, 75);
+
+// 坏文件：不抛错，退回空表
+const badFile = path.join(tmp, 'bad.json');
+fs.writeFileSync(badFile, '{not json', 'utf8');
+assert.deepEqual(loadAffection(badFile).people, {});
+
+// ── ③ 判定：≥门槛解锁 / <门槛低频 ─────────────────────────────────────────
+const gate = normalizeVoiceAffection({ fullAt: 60, lowCooldownHours: 6, lowMaxPerDay: 2 });
+const now = Date.now();
+
+assert.equal(voiceAffectionDecision({ score: 60, gate, now }).tier, 'full', '正好 60 应解锁');
+assert.equal(voiceAffectionDecision({ score: 100, gate, now }).tier, 'full');
+assert.equal(voiceAffectionDecision({ score: 59, gate, now, dayCount: 0, lastAt: 0 }).tier, 'low', '59 走低频，但仍允许');
+
+const cooled = voiceAffectionDecision({ score: 59, gate, now, dayCount: 1, lastAt: now - 2 * 3600_000 });
+assert.equal(cooled.tier, 'blocked');
+assert.equal(cooled.allowed, false);
+assert.match(cooled.reason, /小时|冷却/);
+
+const fresh = voiceAffectionDecision({ score: 59, gate, now, dayCount: 1, lastAt: now - 7 * 3600_000 });
+assert.equal(fresh.tier, 'low', '过了冷却就恢复低频可用');
+
+const capped = voiceAffectionDecision({ score: 59, gate, now, dayCount: 2, lastAt: now - 7 * 3600_000 });
+assert.equal(capped.tier, 'blocked');
+assert.match(capped.reason, /每天最多|额度/);
+
+// 门槛关掉：一律放行（旧行为），不再卡低频
+const off = normalizeVoiceAffection({ enabled: false });
+assert.equal(voiceAffectionDecision({ score: 0, gate: off, now, dayCount: 99 }).tier, 'full');
+
+// 每日上限 0 表示不设上限
+const noCap = normalizeVoiceAffection({ lowMaxPerDay: 0 });
+assert.equal(voiceAffectionDecision({ score: 0, gate: noCap, now, dayCount: 50, lastAt: 0 }).tier, 'low');
+
+// ── ④ 记账：跨天清零、冷却保留 ─────────────────────────────────────────────
+let state = loadVoiceAffectionState(stateFile);
+assert.deepEqual(state.people, {}, '状态文件不存在时为空');
+state = noteVoiceAffectionSent(state, '2781448117', now);
+assert.equal(state.people['2781448117'].dayCount, 1);
+assert.equal(state.people['2781448117'].day, day);
+state = noteVoiceAffectionSent(state, '2781448117', now);
+assert.equal(state.people['2781448117'].dayCount, 2, '同一天再记一次应累加');
+assert.equal(state.people['2781448117'].day, day);
+saveVoiceAffectionState(stateFile, state);
+const reloaded = loadVoiceAffectionState(stateFile);
+assert.equal(reloaded.people['2781448117'].dayCount, 2);
+assert.ok(reloaded.people['2781448117'].lastAt > 0);
+
+// 昨天的记录：dayCount 归零，但 lastAt 还在（冷却仍生效）
+const yesterday = { version: 1, people: { '2781448117': { lastAt: now - 3 * 3600_000, day: '2000-01-01', dayCount: 5 } } };
+const usage = voiceAffectionUsage(yesterday, '2781448117', now);
+assert.equal(usage.dayCount, 0, '跨天每日条数清零');
+assert.equal(usage.lastAt, now - 3 * 3600_000, '上次发送时间保留（冷却用）');
+assert.equal(voiceAffectionUsage(yesterday, '999', now).dayCount, 0);
+
+// 非 QQ 号不记账（防脏键）
+state = noteVoiceAffectionSent({ version: 1, people: {} }, 'abc');
+assert.deepEqual(state.people, {});
+
+// 路径约定：state/voice-affection.json
+assert.equal(voiceAffectionStateFile(path.join(tmp, 'state')).endsWith('voice-affection.json'), true);
+
+try { fs.rmSync(tmp, { recursive: true, force: true }); } catch {}
+console.log('OK test-voice-affection');
